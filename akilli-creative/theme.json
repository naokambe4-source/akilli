{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"layout": { "contentSize": "736px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Siyah", "color": "#0d0d0d" },
				{ "slug": "primary", "name": "Turuncu", "color": "#f04e00" },
				{ "slug": "tint", "name": "Açık turuncu", "color": "#fff1e8" },
				{ "slug": "accent", "name": "Koyu turuncu (metin)", "color": "#b83b00" },
				{ "slug": "paper", "name": "Beyaz", "color": "#ffffff" },
				{ "slug": "white", "name": "Gri yüzey", "color": "#f5f5f3" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Küçük", "size": "0.92rem" },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem" },
				{ "slug": "large", "name": "Büyük", "size": "1.35rem" },
				{ "slug": "x-large", "name": "Çok büyük", "size": "clamp(1.8rem, 1.2rem + 2vw, 2.6rem)" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	}
}
