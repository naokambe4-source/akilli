{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"layout": { "contentSize": "736px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "name": "Lacivert", "color": "#0e1530" },
				{ "slug": "primary", "name": "Mercan", "color": "#ff5b2e" },
				{ "slug": "tint", "name": "Şeftali", "color": "#ffe7dc" },
				{ "slug": "accent", "name": "Koyu mercan (metin)", "color": "#b8401d" },
				{ "slug": "paper", "name": "Sıcak beyaz", "color": "#faf8f5" },
				{ "slug": "white", "name": "Beyaz", "color": "#ffffff" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Küçük", "size": "0.92rem" },
				{ "slug": "medium", "name": "Normal", "size": "1.0625rem" },
				{ "slug": "large", "name": "Büyük", "size": "1.35rem" },
				{ "slug": "x-large", "name": "Çok büyük", "size": "clamp(1.8rem, 1.2rem + 2vw, 2.6rem)" }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	}
}
